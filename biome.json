{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/public", "!**/.claude/settings.local.json"]
	},
	"plugins": ["./platform/quality/multi-property-object.grit"],
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["..", "../**"],
								"message": "Use an absolute path: '../' is not allowed, and './' only reaches a sibling file."
							}
						]
					}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							{
								"source": [
									"**",
									"!:ALIAS:",
									"!:PATH:",
									"!@app/**",
									"!@components/**",
									"!@data/**",
									"!@event-testdata/**",
									"!@factories/**",
									"!@i18n/**",
									"!@infra/**",
									"!@metadata/**",
									"!@services/**",
									"!@state"
								]
							},
							":BLANK_LINE:",
							[
								":ALIAS:",
								"@app/**",
								"@components/**",
								"@data/**",
								"@event-testdata/**",
								"@factories/**",
								"@i18n/**",
								"@infra/**",
								"@metadata/**",
								"@services/**",
								"@state"
							],
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	}
}

{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/public",
			"!**/.claude/settings.local.json",
			"!apps/website-old"
		]
	},
	"plugins": ["./platform/quality/multi-property-object.grit"],
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["..", "../**"],
								"message": "Use an absolute path: '../' is not allowed, and './' only reaches a sibling file."
							}
						]
					}
				},
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "interface"
					}
				},
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				}
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "warn",
				"useExhaustiveDependencies": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							{
								"source": [
									"**",
									"!:ALIAS:",
									"!:PATH:",
									"!@app/**",
									"!@components/**",
									"!@data/**",
									"!@event-testdata/**",
									"!@factories/**",
									"!@i18n/**",
									"!@services/**",
									"!@state"
								]
							},
							":BLANK_LINE:",
							[
								":ALIAS:",
								"@app/**",
								"@components/**",
								"@data/**",
								"@event-testdata/**",
								"@factories/**",
								"@i18n/**",
								"@services/**",
								"@state"
							],
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	}
}

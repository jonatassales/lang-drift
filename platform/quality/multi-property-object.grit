language js

// A single-line object literal with a comma at its top level holds more than
// one property. Strings, nested objects, arrays and calls are skipped so their
// commas do not count. Break the object after `{` and Biome puts each property
// on its own line.
JsObjectExpression() as $object where {
	$object <: r"\{\s*(?:'[^'\n]*'|\"[^\"\n]*\"|`[^`\n]*`|\{[^{}\n]*\}|\[[^\[\]\n]*\]|\([^()\n]*\)|[^'\"`{}\[\](),\n])+,\s*[^\s}][^\n]*\}",
	register_diagnostic(span=$object, message="Put each property of a multi-property object on its own line.")
}

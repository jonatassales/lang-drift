# Local development for extub (go run ./cmd/server on 127.0.0.1).
# extub reads only the process environment and never loads this file:
# export the variables in the shell, or keep the defaults below.
EXTUB_PORT=3401

# Hosted preview only, set on Vercel. Leave both unset locally: with a token,
# extub listens on every interface at PORT (3000) as a read-only preview.
# EXTUB_TOKEN=
# PORT=

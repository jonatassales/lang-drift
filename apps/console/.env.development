# Local development for the console (next dev on 127.0.0.1:3001).
# The console reads console-stubs over plain http on loopback. This is the default,
# so the line may be left out; any other value must stay http on loopback.
CONSOLE_STUBS_URL=http://127.0.0.1:3401

# Hosted preview only, set on Vercel. Leave it unset locally: a token lets
# the console serve any host and send the token to console-stubs.
# CONSOLE_STUBS_TOKEN=

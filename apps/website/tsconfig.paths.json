{
	"compilerOptions": {
		"paths": {
			"@app/*": ["./src/app/*"],
			"@layout/*": ["./src/app/[locale]/*"],
			"@routes/*": ["./src/app/[locale]/(pages)/*"],
			"@api/*": ["./src/app/api/*"],
			"@factories/*": ["./src/factories/*"],
			"@i18n/*": ["./src/app/template/i18n/*"],
			"@proxy/*": ["./src/proxy/*"],
			"@infra/*": ["./src/infra/*"],
			"@services/*": ["./src/services/*"],
			"@state": ["./src/app/state/index.ts"]
		}
	}
}

# Local development for console-stubs (go run ./cmd/server on 127.0.0.1).
# console-stubs reads only the process environment and never loads this file:
# export the variables in the shell, or keep the defaults below.
CONSOLE_STUBS_PORT=3401

# Hosted preview only, set on Vercel. Leave both unset locally: with a token,
# console-stubs listens on every interface at PORT (3000) as a read-only preview.
# CONSOLE_STUBS_TOKEN=
# PORT=

{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["VERCEL_ENV"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"typegen": {
			"dependsOn": ["transit"],
			"outputs": [".next/types/**", "next-env.d.ts"]
		},
		"typecheck": {
			"dependsOn": ["transit", "typegen"]
		},
		"test": {
			"dependsOn": ["transit"]
		},
		"//#check": {
			"cache": false
		},
		"//#fix": {
			"cache": false
		}
	},
	"globalPassThroughEnv": [
		"CRYPTO_SECRET",
		"CI",
		"CONSOLE_STUBS_URL",
		"CONSOLE_STUBS_TOKEN"
	]
}

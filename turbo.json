{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"website#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["VERCEL_ENV", "WEBSITE_PREVIEW_SIGNUP_DISABLED"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"test": {
			"dependsOn": ["transit"]
		},
		"//#check": {
			"cache": false
		},
		"//#fix": {
			"cache": false
		}
	},
	"globalPassThroughEnv": [
		"CRYPTO_SECRET",
		"CI",
		"NEXT_TELEMETRY_DISABLED",
		"NODE_OPTIONS"
	]
}

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# Go binaries built into a bin/ folder; the CLI's tracked launcher is source
bin/
!lib/cli/bin/
.next/
next-env.d.ts
*.tsbuildinfo

# Caches and reports
.turbo/
coverage/

# Environment: shared development defaults are tracked; only .env is ignored
.env

# Operating system
.DS_Store

# Per-session markers written by the LLM effort analyzer
.agents/workflow/.effort-log/*


# The LangDrift folder is machine-local; ex regenerates it (spec 0016)
/.langdrift/

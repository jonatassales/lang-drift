{
	"name": "langdrift",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.4.2",
			"onFail": "download"
		}
	},
	"scripts": {
		"postinstall": "sh platform/cli/drift setup",
		"prepare": "husky platform/cli/.husky",
		"website": "turbo run dev --filter=website",
		"console": "turbo run dev --filter=console",
		"check": "biome check .",
		"fix": "biome check --write ."
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css}": "biome check --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@langdrift/cli": "0.4.0",
		"@vitest/coverage-v8": "5.0.5",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"turbo": "2.11.7"
	}
}

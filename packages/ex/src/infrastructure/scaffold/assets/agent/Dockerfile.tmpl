# The consumer builds this image explicitly; ex never builds or pulls it.
# Pin a reviewed digest when reproducible base-image identity is required.
FROM node:22-bookworm-slim AS build
WORKDIR /agent
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=production LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false
WORKDIR /agent
COPY --from=build --chown=node:node /agent/package.json ./
COPY --from=build --chown=node:node /agent/node_modules ./node_modules
COPY --from=build --chown=node:node /agent/dist ./dist
USER node
CMD ["node", "dist/index.js"]

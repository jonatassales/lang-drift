				"secondary-foreground": { "$value": "{dark.lg.color.foreground}" },
				"muted": { "$value": "{lg.color.gray.800}" },
				"muted-foreground": { "$value": "#A1A1AA" },
				"accent": { "$value": "{lg.color.gray.800}" },
				"accent-foreground": { "$value": "{dark.lg.color.foreground}" },
				"destructive": { "$value": "{dark.lg.status.danger}" },
				"border": { "$value": "#2A2A2D" },
				"input": { "$value": "{dark.lg.color.border}" },
				"ring": { "$value": "{dark.lg.color.primary}" },
				"chart-1": { "$value": "{dark.lg.color.primary}" },
				"chart-2": { "$value": "#2DD4BF" },

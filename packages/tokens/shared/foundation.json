{
	"lg": {
		"color": {
			"$type": "color",
			"gray": {
				"50": {
					"$value": "#fafafa"
				},
				"100": {
					"$value": "#f5f5f5"
				},
				"200": {
					"$value": "#e5e5e5"
				},
				"400": {
					"$value": "#a3a3a3"
				},
				"800": {
					"$value": "#262626"
				},
				"900": {
					"$value": "#171717"
				},
				"950": {
					"$value": "#0a0a0a"
				}
			}
		},
		"typography": {
			"font": {
				"$type": "fontFamily",
				"body": {
					"$value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"$extensions": {
						"dev.langdrift.tailwind": "--font-sans"
					}
				},
				"mono": {
					"$value": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
					"$extensions": {
						"dev.langdrift.tailwind": "--font-mono"
					}
				}
			}
		},
		"effects": {
			"shadow": {
				"$type": "shadow",
				"sm": {
					"$value": "0px 1px 2px #00000014",
					"$extensions": {
						"dev.langdrift.tailwind": "--shadow-sm"
					}
				}
			},
			"easing": {
				"$type": "cubicBezier",
				"standard": {
					"$value": "cubic-bezier(0.2, 0, 0, 1)",
					"$extensions": {
						"dev.langdrift.tailwind": "--ease-standard"
					}
				}
			}
		}
	}
}

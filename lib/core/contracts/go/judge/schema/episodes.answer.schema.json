{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://langdrift.md/schemas/judge/episodes.answer.schema.json",
	"title": "Episodes answer",
	"description": "Per earlier run the RAG retrieved, why it is or is not comparable to the ticket.",
	"type": "object",
	"additionalProperties": false,
	"required": ["episodes"],
	"properties": {
		"episodes": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["run", "reason"],
				"properties": {
					"run": {
						"type": "string",
						"minLength": 1
					},
					"reason": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}

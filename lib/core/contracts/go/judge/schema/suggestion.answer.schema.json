{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://langdrift.md/schemas/judge/suggestion.answer.schema.json",
	"title": "Suggestion answer",
	"description": "The suggested model and effort for running the ticket's workflow, with the reasons.",
	"type": "object",
	"additionalProperties": false,
	"required": ["model", "effort", "effortReason", "modelReason", "reasons"],
	"properties": {
		"model": {
			"type": "string",
			"minLength": 1
		},
		"effort": {
			"enum": ["low", "medium", "high"]
		},
		"effortReason": {
			"type": "string",
			"minLength": 1
		},
		"modelReason": {
			"type": "string",
			"minLength": 1
		},
		"reasons": {
			"type": "array",
			"maxItems": 3,
			"items": {
				"type": "string",
				"minLength": 1
			}
		}
	}
}

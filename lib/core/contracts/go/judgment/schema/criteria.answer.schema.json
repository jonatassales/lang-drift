{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://langdrift.md/schemas/judgment/criteria.answer.schema.json",
	"title": "Criteria answer",
	"description": "The guardrail criteria the judge finds apply to the ticket, each with its id and what it requires, as \"judging · FIN-02 estimate before a paid call · …\" prints them.",
	"type": "object",
	"additionalProperties": false,
	"required": ["criteria"],
	"properties": {
		"criteria": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "statement"],
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"statement": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}

{
	"name": "@langdrift/core",
	"version": "0.3.0",
	"description": "LangDrift Microruntimes contracts: the JSON Schemas and samples of the runtime.md fence, the judge's answers and the stage reports",
	"license": "Apache-2.0",
	"homepage": "https://langdrift.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonatassales/lang-drift.git",
		"directory": "lib/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./configuration/*": "./contracts/go/configuration/schema/*",
		"./judge/*": "./contracts/go/judge/schema/*",
		"./judgment/*": "./contracts/go/judgment/schema/*",
		"./stages/*": "./contracts/go/stages/schema/*"
	},
	"files": [
		"contracts/go/configuration/schema/*.json",
		"contracts/go/judge/schema/*.json",
		"contracts/go/judgment/schema/*.json",
		"contracts/go/stages/schema/*.json",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"test": "go -C contracts/go test ./...",
		"typecheck": "go -C contracts/go vet ./..."
	}
}

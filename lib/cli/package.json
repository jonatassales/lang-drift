{
	"name": "@langdrift/cli",
	"version": "0.4.0",
	"description": "LangDrift FinOps and Microruntimes CLI",
	"license": "Apache-2.0",
	"homepage": "https://langdrift.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonatassales/lang-drift.git",
		"directory": "lib/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"dft": "./bin/dft.sh"
	},
	"files": [
		"bin/dft.sh",
		"dist/dft-darwin-arm64",
		"dist/dft-darwin-amd64",
		"dist/dft-linux-amd64",
		"dist/dft-linux-arm64",
		"LICENSE",
		"README.md"
	],
	"os": [
		"darwin",
		"linux"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"build": "sh build.sh",
		"prepack": "sh build.sh --release",
		"test": "go test -race ./...",
		"typecheck": "go vet ./..."
	},
	"devDependencies": {
		"@langdrift/core": "workspace:*"
	}
}
